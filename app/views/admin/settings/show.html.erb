<h1>Settings</h1>

<%= form_tag admin_settings_path, method: :patch, class: "card" do %>
  <% @settings.each do |setting| %>
    <div class="form-group">
      <label for="settings_<%= setting.key %>"><%= setting.key.humanize %></label>
      <% if setting.key == "greeting_text" || setting.key == "voicemail_prompt" %>
        <textarea name="settings[<%= setting.key %>]" id="settings_<%= setting.key %>"><%= setting.value %></textarea>
      <% elsif setting.key == "greeting_variant" %>
        <select name="settings[<%= setting.key %>]" id="settings_<%= setting.key %>">
          <% GreetingCatalog::VARIANTS.each do |variant| %>
            <option value="<%= variant.slug %>" <%= "selected" if setting.value == variant.slug %>>
              <%= variant.label %>
            </option>
          <% end %>
        </select>
        <% current = GreetingCatalog.find(setting.value) %>
        <% if current %>
          <small style="display: block; margin-top: 0.25rem; color: var(--text-muted);">
            <%= current.text %>
          </small>
        <% end %>
      <% elsif setting.key == "greeting_tone" %>
        <select name="settings[<%= setting.key %>]" id="settings_<%= setting.key %>">
          <% GreetingCatalog::TONES.each do |slug, info| %>
            <option value="<%= slug %>" <%= "selected" if setting.value == slug %>>
              <%= info[:label] %>
            </option>
          <% end %>
        </select>
      <% elsif setting.key == "greeting_language" %>
        <select name="settings[<%= setting.key %>]" id="settings_<%= setting.key %>">
          <% [["Italian", "it-IT"], ["English", "en-US"], ["French", "fr-FR"], ["German", "de-DE"], ["Spanish", "es-ES"]].each do |label, val| %>
            <option value="<%= val %>" <%= "selected" if setting.value == val %>><%= label %></option>
          <% end %>
        </select>
      <% elsif setting.key == "greeting_voice" %>
        <select name="settings[<%= setting.key %>]" id="settings_<%= setting.key %>">
          <% current_variant = Setting.get("greeting_variant").to_s %>
          <% current_tone = Setting.get("greeting_tone").to_s %>
          <% Setting::ALLOWED_VOICES.each do |v| %>
            <% label = GreetingCatalog::VOICES[v] || v %>
            <% rendered = Rails.root.join("storage/greetings", current_variant, v, "#{current_tone}.wav").exist? %>
            <option value="<%= v %>" <%= "selected" if setting.value == v %>>
              <%= label %><%= rendered ? " ✓" : "" %>
            </option>
          <% end %>
        </select>
        <small style="display: block; margin-top: 0.25rem; color: var(--text-muted);">
          ✓ = pre-rendered audio for the currently selected phrase + tone. Otherwise the call falls back to Telnyx's built-in voice.
        </small>
      <% elsif setting.key == "transcription_engine" %>
        <select name="settings[<%= setting.key %>]" id="settings_<%= setting.key %>">
          <% Setting::ALLOWED_TRANSCRIPTION_ENGINES.each do |v| %>
            <option value="<%= v %>" <%= "selected" if setting.value == v %>><%= v %></option>
          <% end %>
        </select>
      <% else %>
        <input type="text" name="settings[<%= setting.key %>]" id="settings_<%= setting.key %>" value="<%= setting.value %>">
      <% end %>
    </div>
  <% end %>

  <button type="submit" class="btn btn-primary">Save Settings</button>
<% end %>
