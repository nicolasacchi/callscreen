<h1>Dashboard</h1>

<% if @stats[:total_all].zero? %>
  <div class="card">
    <h3>Getting started</h3>
    <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 0.5rem;">No calls screened yet. To go live:</p>
    <ul style="font-size: 0.875rem; line-height: 1.9; padding-left: 1.25rem;">
      <li>Forward your number to the Telnyx number (the dial-back number lives in <%= link_to "Profile", edit_admin_profile_path %>).</li>
      <li>Pick a greeting and voice in <%= link_to "Profile", edit_admin_profile_path %>.</li>
      <li>Set your <strong>ntfy URL</strong> in <%= link_to "Profile", edit_admin_profile_path %> so screened calls reach your phone.</li>
      <li>Optionally add custom <%= link_to "Phrases", admin_phrases_path %> and screening <%= link_to "Rules", admin_rules_path %>.</li>
    </ul>
  </div>
<% end %>

<div class="stats">
  <div class="stat-card">
    <div class="label">Today Total</div>
    <div class="value"><%= @stats[:total_today] %></div>
  </div>
  <div class="stat-card">
    <div class="label">Today Spam</div>
    <div class="value" style="color: var(--spam)"><%= @stats[:spam_today] %></div>
  </div>
  <div class="stat-card">
    <div class="label">Today Legit</div>
    <div class="value" style="color: var(--legit)"><%= @stats[:legit_today] %></div>
  </div>
  <div class="stat-card">
    <div class="label">Recorded</div>
    <div class="value"><%= @stats[:recorded_today] %></div>
  </div>
  <div class="stat-card">
    <div class="label">All Calls</div>
    <div class="value"><%= @stats[:total_all] %></div>
  </div>
  <div class="stat-card">
    <div class="label">Contacts</div>
    <div class="value"><%= @stats[:contacts] %></div>
  </div>
  <div class="stat-card">
    <div class="label">Whitelisted</div>
    <div class="value" style="color: var(--legit)"><%= @stats[:whitelisted] %></div>
  </div>
  <div class="stat-card">
    <div class="label">Blacklisted</div>
    <div class="value" style="color: var(--spam)"><%= @stats[:blacklisted] %></div>
  </div>
</div>

<div class="chart-container">
  <h3 style="margin-bottom: 0.5rem; font-size: 0.875rem; color: var(--text-muted);">Calls (30 days)</h3>
  <%= line_chart [
    { name: "Total", data: @daily_calls },
    { name: "Spam", data: @daily_spam }
  ], colors: ["#6366f1", "#ef4444"], library: { scales: { y: { beginAtZero: true } } } %>
</div>

<div class="card">
  <h3>Screening insights (<%= @insights[:window_days] %> days)</h3>
  <div class="stats">
    <div class="stat-card">
      <div class="label">Spam rate</div>
      <div class="value" style="color: var(--spam)"><%= @insights[:spam_rate] %>%</div>
    </div>
    <div class="stat-card">
      <div class="label">Spam calls</div>
      <div class="value"><%= @insights[:spam] %> / <%= @insights[:total] %></div>
    </div>
    <div class="stat-card">
      <div class="label">Blocked before answer</div>
      <div class="value"><%= @insights[:blocked_before_answer] %></div>
    </div>
    <div class="stat-card">
      <div class="label">LLM accuracy (reviewed)</div>
      <div class="value"><%= @insights[:llm_accuracy] ? "#{@insights[:llm_accuracy]}%" : "—" %></div>
    </div>
  </div>
  <% if @insights[:top_spam_callers].any? %>
    <h4 style="margin: 1rem 0 0.5rem; font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Top spam callers</h4>
    <table>
      <thead><tr><th>Number</th><th>Spam calls</th></tr></thead>
      <tbody>
        <% @insights[:top_spam_callers].each do |number, count| %>
          <tr><td><%= number %></td><td><%= count %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<h3 style="margin-bottom: 0.75rem;">Recent Calls</h3>
<table>
  <thead>
    <tr>
      <th>Time</th>
      <th>From</th>
      <th>Status</th>
      <th>Screening</th>
      <th>AI Reason</th>
    </tr>
  </thead>
  <tbody>
    <% @recent_calls.each do |call| %>
      <tr>
        <td><%= link_to call.created_at.in_time_zone(tenant_time_zone).strftime("%H:%M %d/%m"), admin_call_path(call) %></td>
        <td><%= call.contact_name %></td>
        <td><span class="badge badge-<%= call.status %>"><%= call.status %></span></td>
        <td class="truncate"><%= call.screening_transcript %></td>
        <td class="truncate"><%= call.ai_reason %></td>
      </tr>
    <% end %>
  </tbody>
</table>
