<h1>Recordings<%= " — #{viewing_tenant.display_name}" if super_admin? && params[:tenant_id].present? %></h1>

<% if super_admin? %>
  <div class="toolbar">
    <%= form_tag admin_recordings_path, method: :get, style: "display: flex; gap: 0.5rem; align-items: center;" do %>
      <select name="tenant_id" onchange="this.form.submit()">
        <option value="">My recordings (<%= current_tenant.display_name %>)</option>
        <% Tenant.order(:name).each do |t| %>
          <option value="<%= t.id %>" <%= "selected" if params[:tenant_id].to_s == t.id.to_s %>>
            <%= t.display_name %>
          </option>
        <% end %>
      </select>
    <% end %>
  </div>
<% end %>

<% if @calls.empty? %>
  <p style="color: var(--text-muted);">No recordings yet.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th style="width: 11rem;">Time</th>
        <th>From</th>
        <th>Status</th>
        <th style="width: 5rem;">Length</th>
        <th>Recording</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @calls.each do |call| %>
        <tr>
          <td><%= call.created_at.in_time_zone("Europe/Rome").strftime("%Y-%m-%d %H:%M") %></td>
          <td>
            <%= phone_link(call.from_number) %>
            <% if call.contact %>
              <br><small><%= call.contact.display_name %></small>
            <% end %>
          </td>
          <td><span class="badge badge-<%= call.status %>"><%= call.status.capitalize %></span></td>
          <td><%= call.duration_seconds %>s</td>
          <td>
            <audio controls preload="none" style="width: 100%; max-width: 22rem;">
              <source src="<%= recording_path(call.id) %>" type="audio/wav">
            </audio>
            <% if call.recording_local_path.blank? %>
              <small style="display: block; color: var(--text-muted);">Streamed from Telnyx on first play.</small>
            <% end %>
          </td>
          <td><%= link_to "Detail", admin_call_path(call), class: "btn btn-sm" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @pagination && @pagination[:total_pages] > 1 %>
  <div class="pagination">
    <% if @pagination[:current_page] > 1 %>
      <%= link_to "Prev", admin_recordings_path(page: @pagination[:current_page] - 1, tenant_id: params[:tenant_id]), class: "btn btn-sm" %>
    <% end %>
    <span>Page <%= @pagination[:current_page] %> of <%= @pagination[:total_pages] %></span>
    <% if @pagination[:current_page] < @pagination[:total_pages] %>
      <%= link_to "Next", admin_recordings_path(page: @pagination[:current_page] + 1, tenant_id: params[:tenant_id]), class: "btn btn-sm" %>
    <% end %>
  </div>
<% end %>
