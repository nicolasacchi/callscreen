<h1>Call Detail</h1>

<div class="card">
  <dl class="detail-grid">
    <dt>Call SID</dt>
    <dd><%= @call.call_sid %></dd>

    <dt>From</dt>
    <dd>
      <%= phone_link(@call.from_number) %>
      <% if @call.contact %>
        (<%= link_to @call.contact.display_name, admin_contact_path(@call.contact) %>)
      <% end %>
    </dd>

    <dt>To</dt>
    <dd><%= @call.to_number %></dd>

    <dt>Status</dt>
    <dd><span class="badge badge-<%= @call.status %>"><%= @call.status %></span></dd>

    <dt>Time</dt>
    <dd><%= @call.created_at.in_time_zone("Europe/Rome").strftime("%H:%M:%S %d/%m/%Y") %></dd>

    <dt>Duration</dt>
    <dd><%= @call.duration_seconds ? "#{@call.duration_seconds}s" : "-" %></dd>

    <% if @call.selected_phrase_slug.present? %>
      <dt>Played phrase</dt>
      <dd><code><%= @call.selected_phrase_slug %></code></dd>
    <% end %>

    <% if @call.selected_voice.present? %>
      <dt>Voice</dt>
      <dd><code><%= @call.selected_voice %></code></dd>
    <% end %>
  </dl>
</div>

<% if @call.screening_transcript.present? %>
  <div class="card">
    <h3>Screening Transcript</h3>
    <p style="white-space: pre-wrap;"><%= @call.screening_transcript %></p>
  </div>
<% end %>

<% if @call.ai_classification.present? %>
  <div class="card">
    <h3>AI Classification</h3>
    <dl class="detail-grid">
      <dt>Classification</dt>
      <dd><span class="badge <%= classification_badge_class(@call.ai_classification["classification"]) %>"><%= classification_display(@call.ai_classification["classification"]) %></span></dd>
      <dt>Confidence</dt>
      <dd><%= @call.ai_confidence ? "#{(@call.ai_confidence * 100).round}%" : "-" %></dd>
      <dt>Reason</dt>
      <dd><%= @call.ai_reason %></dd>
    </dl>
  </div>
<% end %>

<div class="card">
  <h3>Cost</h3>
  <dl class="detail-grid">
    <dt>Telnyx voice</dt>
    <dd>
      <%= number_to_currency(@call.telnyx_cost_usd || 0, unit: "$", precision: 4) %>
      <% if @call.billable_seconds %>
        <small style="color: var(--text-muted);">(<%= @call.billable_seconds %>s billed)</small>
      <% end %>
    </dd>
    <dt>Moonshot LLM</dt>
    <dd>
      <%= number_to_currency(@call.moonshot_cost_usd || 0, unit: "$", precision: 4) %>
      <% if @call.llm_classified? && @call.moonshot_tokens_in %>
        <small style="color: var(--text-muted);">
          (<%= @call.moonshot_tokens_in %> in / <%= @call.moonshot_tokens_out %> out)
        </small>
      <% elsif @call.ai_classification_source.present? && @call.ai_classification_source != "llm" %>
        <small style="color: var(--text-muted);">(skipped — <%= @call.ai_classification_source %>)</small>
      <% end %>
    </dd>
    <dt>Total</dt>
    <dd><strong><%= number_to_currency(@call.total_cost_usd, unit: "$", precision: 4) %></strong></dd>
  </dl>
</div>

<% if @call.voicemail_transcript.present? %>
  <div class="card">
    <h3>Voicemail Transcript</h3>
    <p style="white-space: pre-wrap;"><%= @call.voicemail_transcript %></p>
  </div>
<% end %>

<% if @call.recording_local_path.present? || @call.recording_url.present? %>
  <div class="card">
    <h3>Recording</h3>
    <audio controls preload="metadata" style="width: 100%;">
      <source src="<%= recording_path(@call.id) %>" type="audio/wav">
    </audio>
    <% if @call.recording_local_path.blank? %>
      <small style="color: var(--text-muted);">Fetched from Telnyx and cached locally on first play.</small>
    <% end %>
  </div>
<% end %>

<div class="actions" style="margin-top: 1rem;">
  <% unless @call.spam? %>
    <%= button_to "Mark Spam", mark_spam_admin_call_path(@call), class: "btn btn-danger btn-sm" %>
  <% end %>
  <% unless @call.legit? %>
    <%= button_to "Mark Legit", mark_legit_admin_call_path(@call), class: "btn btn-sm" %>
  <% end %>
  <% if @call.contact&.whitelisted? %>
    <span class="badge badge-legit">✓ Already trusted</span>
  <% else %>
    <%= button_to "Whitelist Number", whitelist_number_admin_call_path(@call),
                  class: "btn btn-sm",
                  data: { turbo_confirm: "Trust #{@call.from_number}? Future calls will skip screening and ring your phone directly." } %>
  <% end %>
  <% if @call.contact&.blacklisted? %>
    <span class="badge badge-spam">⚑ Already blocked</span>
  <% else %>
    <%= button_to "Block Number", block_number_admin_call_path(@call), class: "btn btn-danger btn-sm", data: { turbo_confirm: "Block #{@call.from_number}?" } %>
  <% end %>
  <%= link_to "Back", admin_calls_path, class: "btn btn-sm" %>
</div>
