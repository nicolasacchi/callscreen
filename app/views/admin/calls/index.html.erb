<h1>Calls<%= " — #{viewing_tenant.display_name}" if super_admin? && params[:tenant_id].present? %></h1>

<div class="toolbar">
  <%= form_tag admin_calls_path, method: :get, style: "display: flex; gap: 0.5rem; align-items: center;" do %>
    <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search phone number...">
    <select name="status" onchange="this.form.submit()">
      <option value="">All statuses</option>
      <% Call.statuses.keys.each do |s| %>
        <option value="<%= s %>" <%= "selected" if params[:status] == s %>><%= s.capitalize %></option>
      <% end %>
    </select>
    <% if super_admin? %>
      <select name="tenant_id" onchange="this.form.submit()">
        <option value="">My calls (<%= current_tenant.display_name %>)</option>
        <% Tenant.order(:name).each do |t| %>
          <option value="<%= t.id %>" <%= "selected" if params[:tenant_id].to_s == t.id.to_s %>>
            <%= t.display_name %>
          </option>
        <% end %>
      </select>
    <% end %>
    <button type="submit" class="btn btn-sm">Filter</button>
  <% end %>
</div>

<% if @calls.none? %>
  <div class="empty-state">
    <% if params[:q].present? || params[:status].present? %>
      No calls match this filter.
    <% else %>
      No calls yet. Screened calls will appear here once your number starts forwarding to Telnyx.
    <% end %>
  </div>
<% else %>
<table>
  <thead>
    <tr>
      <th>Time</th>
      <th>From</th>
      <th>Status</th>
      <th>Screening</th>
      <th>Voicemail</th>
      <th>Duration</th>
      <th>Confidence</th>
    </tr>
  </thead>
  <tbody>
    <% @calls.each do |call| %>
      <tr>
        <td><%= link_to call.created_at.in_time_zone(tenant_time_zone).strftime("%H:%M %d/%m/%y"), admin_call_path(call) %></td>
        <td>
          <% if call.contact %>
            <%= link_to call.contact_name, admin_contact_path(call.contact) %>
            <br><small><%= phone_link(call.from_number) %></small>
          <% else %>
            <%= phone_link(call.from_number) %>
          <% end %>
        </td>
        <td>
          <span class="badge badge-<%= call.status %>"><%= call.status %></span>
          <% if call.unattributed %>
            <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: var(--warning);" title="Tenant could not be identified from History-Info or dedicated_number">unattributed</span>
          <% end %>
        </td>
        <td class="truncate"><%= truncate(call.screening_transcript, length: 60) %></td>
        <td class="truncate"><%= truncate(call.voicemail_transcript, length: 60) %></td>
        <td><%= call.duration_seconds ? "#{call.duration_seconds}s" : "-" %></td>
        <td><%= call.ai_confidence ? "#{(call.ai_confidence * 100).round}%" : "-" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<% end %>

<% if @pagination && @pagination[:total_pages] > 1 %>
  <div class="pagination">
    <% if @pagination[:current_page] > 1 %>
      <%= link_to "Prev", admin_calls_path(page: @pagination[:current_page] - 1, status: params[:status], q: params[:q]), class: "btn btn-sm" %>
    <% end %>
    <span>Page <%= @pagination[:current_page] %> of <%= @pagination[:total_pages] %></span>
    <% if @pagination[:current_page] < @pagination[:total_pages] %>
      <%= link_to "Next", admin_calls_path(page: @pagination[:current_page] + 1, status: params[:status], q: params[:q]), class: "btn btn-sm" %>
    <% end %>
  </div>
<% end %>
